# OpenCorp — local MVP config. Copy to .env. Every value below has a sane
# default baked into the code; you can run the whole stack with an EMPTY .env.
# The only thing worth adding is one LLM key, to turn on real AI autonomy.

# ─── LLM (optional, but this is what makes it "autonomous AI") ───────────────
# With a key + LiteLLM running (`bun run dev` starts it when this is set), the
# agents use a real model. Without it, the worker runs a deterministic offline
# policy and the platform still works end-to-end — just scripted, not "thinking".
ANTHROPIC_API_KEY=
LITELLM_URL=http://localhost:4000
# Optional: turns on semantic lesson recall (§lessons). Names a 1024-dim
# embedding model in litellm.config.yaml (e.g. "embedding" → voyage-3). Unset =
# lessons fall back to score-ranked + keyword recall, no extra provider key.
EMBEDDING_MODEL=

# ─── Auth (optional — leave blank for frictionless local single-owner mode) ──
# Set both to enable real "Sign in with GitHub". Create an OAuth App at
# https://github.com/settings/developers with Authorization callback URL:
#   http://localhost:3001/api/auth/callback/github
# When these are set, `bun run dev` turns real auth ON automatically.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Core (local defaults — usually leave as-is) ─────────────────────────────
DATABASE_URL=postgres://opencorp:opencorp@localhost:5432/opencorp
TEMPORAL_ADDRESS=localhost:7233
GATEWAY_URL=http://localhost:3004
DEPLOYD_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3001
# Where the dashboard links to company sites (deployd serves them path-based).
NEXT_PUBLIC_DEPLOYD_URL=http://localhost:3002
GATEWAY_SECRET=dev-gateway-secret
# Worker isolation: `local` (in-process, simplest) or `subprocess` (separate OS
# process). `e2b` needs a cloud account — leave it for prod.
SANDBOX_KIND=local

# ─── Email delivery (optional — real send to external inboxes like Gmail) ────
# Without this, outbound mail only mirrors into the dashboard inbox (nothing
# leaves). With RESEND_API_KEY + MAIL_DOMAIN each company gets its own address
# (slug@yourdomain.com) that sends through Resend. Two modes:
#
#   Mode A — verified domain (recommended): verify yourdomain.com once in the
#   Resend dashboard (add one DNS TXT record). Leave RESEND_FROM blank. Each
#   company sends as slug@yourdomain.com — recipients see the real address.
#
#   Mode B — shared test sender: leave MAIL_DOMAIN blank or set RESEND_FROM to
#   Resend's shared sender. Only delivers to your own Resend account email.
#   Good for a first smoke-test before DNS setup.
#
# Get a free key at https://resend.com
RESEND_API_KEY=
MAIL_DOMAIN=                    # e.g. yourdomain.com (verified in Resend)
# RESEND_FROM=                  # only set for Mode B (shared/static sender)

# ─── Optional external services (all OFF by default; app degrades gracefully) ─
# Turn these on only when you want the real thing instead of the local mode.
# STALWART_URL=http://localhost:8081      # real email with inbound (docker-compose.dev.yml)
# INFISICAL_URL=http://localhost:8082     # real per-company secret vault
# WITHDRAWAL_FEE_BPS=250                  # platform cash-out fee in basis points (250 = 2.5%); 0 to disable
# Payments: OFF by default → local checkout (no Stripe, no account, fake money).
# Agents create products and a localhost checkout link; "paying" it records the
# sale in the ledger. This is all you need to demo the full sell-a-product loop.
# To use REAL Stripe test mode instead, set the secret below — note the exact
# OPENCORP_SECRET__ prefix (the per-company secret store reads that, NOT a bare
# STRIPE_SECRET_KEY), plus the webhook secret + `stripe listen` so paid events
# report back. Selling needs only these; Stripe Connect is for withdrawals only.
# OPENCORP_SECRET__STRIPE_SECRET_KEY=     # sk_test_… — real Stripe test checkout
# STRIPE_WEBHOOK_SECRET=                  # whsec_… — verifies POST /webhooks/stripe
#                                         # (Stripe CLI: stripe listen --forward-to localhost:3004/webhooks/stripe)
# CHECKOUT_BASE_URL=http://localhost:3004/checkout   # gateway-served local checkout page (local mode)
# E2B_API_KEY=                            # cloud microVM sandboxes (SANDBOX_KIND=e2b)
# BROWSER_KIND=auto                       # real interactive browsing: 'auto' uses Playwright/Chromium when installed
#                                         # (bun add playwright && bunx playwright install chromium), else fetch-only.
#                                         # Set 'fetch' to force the no-JS fallback.
# META_ACCESS_TOKEN=                      # Meta ads (§14); else local mock provider (no real spend)
#                                         # also set conglomerates.meta_ad_account_id (act_…) to go live
# ADS_TARGET_ROAS=2                       # §14 growth loop: scale a campaign up at/above this ROAS
# FORGEJO_URL= / FORGEJO_TOKEN=           # real git hosting
# UMAMI_URL= / UMAMI_TOKEN=               # real analytics
# LANGFUSE_HOST= / LANGFUSE_PUBLIC_KEY= / LANGFUSE_SECRET_KEY=   # public LLM traces

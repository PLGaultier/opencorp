# OpenCorp — local MVP config. Copy to .env. Every value below has a sane
# default baked into the code; you can run the whole stack with an EMPTY .env.
# The only thing worth adding is one LLM key, to turn on real AI autonomy.

# ─── LLM (optional, but this is what makes it "autonomous AI") ───────────────
# With a key + LiteLLM running (`bun run dev` starts it when this is set), the
# agents use a real model. Without it, the worker runs a deterministic offline
# policy and the platform still works end-to-end — just scripted, not "thinking".
ANTHROPIC_API_KEY=
LITELLM_URL=http://localhost:4000

# ─── Core (local defaults — usually leave as-is) ─────────────────────────────
DATABASE_URL=postgres://opencorp:opencorp@localhost:5432/opencorp
TEMPORAL_ADDRESS=localhost:7233
GATEWAY_URL=http://localhost:3004
DEPLOYD_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3001
GATEWAY_SECRET=dev-gateway-secret
# Worker isolation: `local` (in-process, simplest) or `subprocess` (separate OS
# process). `e2b` needs a cloud account — leave it for prod.
SANDBOX_KIND=local

# ─── Optional external services (all OFF by default; app degrades gracefully) ─
# Turn these on only when you want the real thing instead of the local mode.
# STALWART_URL=http://localhost:8081      # real email (docker-compose.dev.yml)
# MAIL_DOMAIN=opencorp.dev
# INFISICAL_URL=http://localhost:8082     # real per-company secret vault
# STRIPE_SECRET_KEY=                      # real payments (else local checkout)
# E2B_API_KEY=                            # cloud microVM sandboxes (SANDBOX_KIND=e2b)
# FORGEJO_URL= / FORGEJO_TOKEN=           # real git hosting
# UMAMI_URL= / UMAMI_TOKEN=               # real analytics
# LANGFUSE_HOST= / LANGFUSE_PUBLIC_KEY= / LANGFUSE_SECRET_KEY=   # public LLM traces

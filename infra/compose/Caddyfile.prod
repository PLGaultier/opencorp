# Production edge (§12). The apex (opencorp.app) is served by Vercel; Caddy here
# manages the control-plane subdomains + company sites. Everything is on-demand:
# an on-demand wildcard (*.{domain}) overlaps the fixed control-plane names and
# suppresses their proactive issuance, so the `ask` endpoint (deployd) authorizes
# both the control-plane subdomains and any published company slug.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://deployd:3002/exists
	}
}

# Control-plane services — fixed hostnames. On-demand TLS, authorized by deployd.
api.{$SITE_DOMAIN} {
	tls {
		on_demand
	}
	reverse_proxy api:3001
}
gw.{$SITE_DOMAIN} {
	tls {
		on_demand
	}
	reverse_proxy gateway:3004
}
llm.{$SITE_DOMAIN} {
	tls {
		on_demand
	}
	reverse_proxy litellm:4000
}

# Company sites: {slug}.{SITE_DOMAIN} → static files deployd wrote to the shared
# volume. {labels.2} is the leftmost label when SITE_DOMAIN has 2 labels
# (acme.opencorp.app → app=0, opencorp=1, acme=2). Adjust if your apex differs.
*.{$SITE_DOMAIN} {
	tls {
		on_demand
	}
	root * /srv/sites/{labels.2}
	file_server
	encode gzip
}
